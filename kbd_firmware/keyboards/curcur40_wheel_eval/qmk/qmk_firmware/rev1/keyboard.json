        "enabled": true,
        "matrix": [0, 0]
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0, "label": "SW_MID"}
            ]
        }
    }
}
