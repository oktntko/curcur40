{
    "keyboard_name": "curcur40 Inertia Wheel Eval Pod",
    "maintainer": "oktntko",
    "manufacturer": "oktntko",
    "url": "https://github.com/oktntko/curcur40",
    "usb": {
        "vid": "0x4653",
